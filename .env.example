# БД
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=payship_core
DB_URL=postgres://admin:admin@localhost:5432/payship_core?sslmode=disable

#Redis
REDIS_ADDR=0.0.0.0:6379
REDIS_POOL_SIZE=10

#Kafka
KAFKA_BROKER=127.0.0.1:9092
KAFKA_BATCH_SIZE=100
KAFKA_CONTAINER_HOST_NAME=payship-kafka
KAFKA_EXTERNAL_PORT=9094

#Worker
WORKER_ADDR=0.0.0.0:8081

#Notifier
NOTIFIER_ADDR=0.0.0.0:8082

# Сервер
SERVER_ADDR=0.0.0.0:8080
SERVER_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200
RATE_LIMIT_FALLBACK_RPS=30
RATE_LIMIT_FALLBACK_BURST=50

#БД Ограничения
MAX_CONNS=20
MIN_CONNS=5
DB_MAX_CONN_IDLE_MINUTES=5m
DB_MAX_CONN_LIFE_HOURS=1h

BASE_URL=http://localhost:8080

#GRAFANA
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

#Тесты
IsTest=true

#Docker
#docker - если запускаем в докере
APP_ENV=notdocker